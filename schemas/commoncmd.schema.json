{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Code Common Commands",
  "description": "Reusable terminal commands.",
  "type": "object",
  "required": ["commands"],
  "properties": {
    "variables": {
      "description": "Variables available to every command.",
      "type": "array",
      "items": { "$ref": "#/definitions/variable" }
    },
    "commands": {
      "description": "Terminal commands shown by Project Atlas.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command"],
        "properties": {
          "command": {
            "description": "Command text inserted into the active terminal.",
            "type": "string",
            "minLength": 1
          },
          "description": {
            "description": "Optional human-readable explanation shown alongside the command.",
            "type": "string"
          },
          "tags": {
            "description": "Optional tags used to group common commands.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "variables": {
            "description": "Variables available only to this command.",
            "type": "array",
            "items": { "$ref": "#/definitions/variable" }
          }
        },
        "defaultSnippets": [
          {
            "label": "Common command",
            "body": {
              "command": "${1:command}",
              "description": "${2:Describe the command}",
              "tags": ["${3:Tag}"]
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "variable": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "label": { "type": "string" },
        "type": { "enum": ["text", "select", "multiSelect", "path"] },
        "required": { "type": "boolean" },
        "default": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "options": { "type": "array", "items": { "type": "string" } },
        "pathKind": { "enum": ["file", "folder", "any"] }
      }
    }
  },
  "defaultSnippets": [
    {
      "label": "Common commands file",
      "body": {
        "commands": [
          {
            "command": "${1:command}",
            "description": "${2:Describe the command}",
            "tags": ["${3:Tag}"]
          }
        ]
      }
    }
  ]
}
